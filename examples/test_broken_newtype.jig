module test_broken_newtype

from std.result import Err, Ok, Result

type Money = Money(int)
type Points = Points(int)


def mix_types(m: Money, p: Points) -> Money:
    """Trying to mix Money and Points - should fail!"""
    effects: none
    examples:
        mix_types(Money(100), Points(50)) -> Money(150)
    return Money(m + p)


def add_raw_int(m: Money) -> Money:
    """Trying to add Money + int - should fail!"""
    effects: none
    examples:
        add_raw_int(Money(100)) -> Money(110)
    return m + 10
