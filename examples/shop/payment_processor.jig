module shop.payment_processor

from lib.stripe import Amount, ChargeId, StripeError, charge, create_customer
from shop.types import Money
from std.result import Result


def process_payment(email: str, amount: Money) -> Result[ChargeId, StripeError]:
    """Create customer and charge them."""
    effects: net
    examples:
        process_payment("test@example.com", Money(100)) -> Ok(ChargeId("ch_100"))
        process_payment("invalid@example.com", Money(100)) -> Err(StripeError.INVALID_CUSTOMER)
    customer_result = create_customer(email)?
    return charge(Amount(int(amount)), customer_result, "usd")
