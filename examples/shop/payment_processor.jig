module shop.payment_processor

from lib.stripe import Amount, ChargeId, Customer, CustomerId, StripeError, charge, create_customer
from shop.types import Money
from std.ctx import Ctx, fixed_ctx
from std.result import Err, Ok, Result


def process_payment(ctx: Ctx, email: str, amount: Money) -> Result[ChargeId, StripeError]:
    """Create customer and charge them."""
    effects: net
    examples:
        process_payment(fixed_ctx(), "test@example.com", Money(100)) -> Ok(ChargeId("ch_100"))
        process_payment(fixed_ctx(), "invalid@example.com", Money(100)) -> Err(StripeError.INVALID_CUSTOMER)
    customer_result = create_customer(email)?
    return charge(Amount(amount.value), customer_result, "usd")
