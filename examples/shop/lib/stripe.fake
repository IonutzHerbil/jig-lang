# Fake implementations for Stripe API for testing

def charge(amount, customer, currency):
    """Fake charge implementation."""
    from jig_runtime import Err, Ok

    # Simulate different error conditions
    if customer == "cus_invalid":
        return Err("INVALID_CUSTOMER")
    if amount.value > 1000000:  # Amount is Amount(int) newtype
        return Err("CARD_DECLINED")

    # Success case
    charge_id = f"ch_{amount.value}"
    return Ok(charge_id)


def create_customer(email):
    """Fake create_customer implementation."""
    from jig_runtime import Err, Ok

    if "invalid" in email:
        return Err("INVALID_CUSTOMER")

    customer_id = "cus_test"
    return Ok(customer_id)


def refund(charge, amount):
    """Fake refund implementation."""
    from jig_runtime import Err, Ok

    return Ok(charge)


def get_customer(customer):
    """Fake get_customer implementation."""
    from jig_runtime import Err, Ok

    # Return a fake customer record
    customer_data = {
        "id": customer,
        "email": "test@example.com",
        "balance": 0
    }
    return Ok(customer_data)
