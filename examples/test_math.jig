module test_math

from std.result import Err, Ok, Result

type Score = Score(int)

enum MathError:
    DIVIDE_BY_ZERO
    NEGATIVE_INPUT

def divide(a: int, b: int) -> Result[int, MathError]:
    """Divide two numbers."""
    effects: none
    examples:
        divide(10, 2) -> Ok(5)
        divide(10, 0) -> Err(MathError.DIVIDE_BY_ZERO)
    if b == 0:
        return Err(MathError.DIVIDE_BY_ZERO)
    return Ok(a / b)


def add_scores(x: Score, y: Score) -> Score:
    """Add two scores together."""
    effects: none
    examples:
        add_scores(Score(10), Score(20)) -> Score(30)
    return Score(x + y)
