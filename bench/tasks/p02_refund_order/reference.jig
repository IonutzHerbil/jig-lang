module store.refunds

from lib.payments import Cents, ChargeId, refund
from std.result import Err, Ok, Result
from store.orders import ANNA, order_total
from store.types import Customer, Line, Money, Sku, StoreError


def refund_order(charge: ChargeId, customer: Customer, lines: list[Line]) -> Result[Money, StoreError]:
    """Refund the order total against an existing charge."""
    effects: net
    examples:
        refund_order(ChargeId("ch_anna_798"), ANNA, [Line(sku=Sku("bread"), quantity=2)]) -> Ok(Money(798))
        refund_order(ChargeId("ch_anna_100"), ANNA, [Line(sku=Sku("bread"), quantity=2)]) -> Err(StoreError.REFUND_FAILED)
    total = order_total(customer, lines)?
    refunded = refund(charge, Cents(int(total)))
    if refunded.is_err():
        return Err(StoreError.REFUND_FAILED)
    return Ok(Money(int(refunded.value)))
