module store.checkout

from lib.payments import Cents, ChargeId, charge
from std.result import Err, Ok, Result
from store.orders import ANNA, order_total
from store.types import Customer, Line, Sku, StoreError


def checkout(customer: Customer, lines: list[Line]) -> Result[ChargeId, StoreError]:
    """Charge the customer for the order total."""
    effects: net
    examples:
        checkout(ANNA, [Line(sku=Sku("bread"), quantity=2)]) -> Ok(ChargeId("ch_anna_798"))
        checkout(ANNA, []) -> Err(StoreError.EMPTY_CART)
    total = order_total(customer, lines)?
    paid = charge(str(customer.id), Cents(int(total)))
    if paid.is_err():
        return Err(StoreError.PAYMENT_DECLINED)
    return Ok(paid.value)
