module solution

from std.result import Err, Ok, Result

VALUES: dict[str, int] = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}


def roman_to_int(s: str) -> Result[int, str]:
    """The integer value of an uppercase Roman numeral."""
    effects: none
    examples:
        roman_to_int("MCMXCIV") -> Ok(1994)
        roman_to_int("") -> Err
        roman_to_int("iv") -> Err
    if s == "" or not all([c in VALUES for c in s]):
        return Err("invalid numeral")
    total = 0
    for i in range(len(s)):
        value = VALUES[s[i]]
        if i + 1 < len(s) and VALUES[s[i + 1]] > value:
            total = total - value
        else:
            total = total + value
    return Ok(total)
