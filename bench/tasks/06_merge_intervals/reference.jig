module solution

from std.result import Err, Ok, Result


def merge_intervals(intervals: list[list[int]]) -> Result[list[list[int]], str]:
    """Merge overlapping or touching closed intervals, sorted by start."""
    effects: none
    examples:
        merge_intervals([[1, 3], [2, 6], [8, 10]]) -> Ok([[1, 6], [8, 10]])
        merge_intervals([[3, 1]]) -> Err
    merged: list[list[int]] = []
    for pair in sorted(intervals):
        if pair[0] > pair[1]:
            return Err("start after end")
        if len(merged) > 0 and pair[0] <= merged[-1][1]:
            merged[-1] = [merged[-1][0], max(merged[-1][1], pair[1])]
        else:
            merged.append([pair[0], pair[1]])
    return Ok(merged)
