{
  "name": "jig-lang",
  "displayName": "Jig Language Support",
  "description": "Jig for VS Code: live checking as you type, hover with types and contracts, go to definition, completion, outline, and highlighting",
  "version": "0.3.0",
  "publisher": "jig-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "jig",
    "llm",
    "code generation",
    "manifests",
    "python"
  ],
  "contributes": {
    "languages": [
      {
        "id": "jig",
        "aliases": [
          "Jig",
          "jig"
        ],
        "extensions": [
          ".jig"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/jig-file-icon.svg",
          "dark": "./icons/jig-file-icon.svg"
        }
      },
      {
        "id": "jig-manifest",
        "aliases": [
          "Jig Manifest"
        ],
        "extensions": [
          ".manifest"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jig-decision",
        "aliases": [
          "Jig Decision"
        ],
        "extensions": [
          ".decision"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jig-pattern",
        "aliases": [
          "Jig Pattern"
        ],
        "extensions": [
          ".pattern"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "jig",
        "scopeName": "source.jig",
        "path": "./syntaxes/jig.tmLanguage.json"
      },
      {
        "language": "jig-manifest",
        "scopeName": "source.jig.manifest",
        "path": "./syntaxes/manifest.tmLanguage.json"
      },
      {
        "language": "jig-decision",
        "scopeName": "source.jig.decision",
        "path": "./syntaxes/decision.tmLanguage.json"
      },
      {
        "language": "jig-pattern",
        "scopeName": "source.jig.pattern",
        "path": "./syntaxes/pattern.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "jig-icons",
        "label": "Jig File Icons",
        "path": "./icons/jig-icon-theme.json"
      }
    ],
    "themes": [
      {
        "label": "Jig Spec Focus",
        "uiTheme": "vs-dark",
        "path": "./themes/jig-spec-focus-color-theme.json"
      }
    ],
    "configuration": {
      "title": "Jig",
      "properties": {
        "jig.pythonPath": {
          "type": "string",
          "default": "",
          "description": "The Python that has Jig installed (pip install jig-lang). Empty: python on Windows, python3 elsewhere."
        }
      }
    },
    "commands": [
      {
        "command": "jig.restartServer",
        "title": "Jig: Restart Language Server"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:jig"
  ]
}
