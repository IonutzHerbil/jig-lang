{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Jig Decision",
  "scopeName": "source.jig.decision",
  "patterns": [
    { "include": "#comments" },
    { "include": "#fields" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.jig",
          "match": "#.*$"
        }
      ]
    },
    "fields": {
      "patterns": [
        {
          "match": "^(decision|context|rationale|enforcement|examples):",
          "name": "keyword.other.field.jig"
        },
        {
          "match": "^\\s*(✓|✗)\\s+",
          "name": "markup.list.jig"
        }
      ]
    }
  }
}
