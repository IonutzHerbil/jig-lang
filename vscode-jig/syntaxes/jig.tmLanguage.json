{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Jig",
  "scopeName": "source.jig",
  "patterns": [
    { "include": "#comments" },
    { "include": "#module" },
    { "include": "#imports" },
    { "include": "#type-definitions" },
    { "include": "#function-definitions" },
    { "include": "#keywords" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#builtin-types" },
    { "include": "#function-calls" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.jig",
          "match": "#.*$"
        },
        {
          "name": "comment.block.jig",
          "begin": "\"\"\"",
          "end": "\"\"\""
        }
      ]
    },
    "module": {
      "patterns": [
        {
          "match": "^(module)\\s+([a-zA-Z_][a-zA-Z0-9_.]*)",
          "captures": {
            "1": { "name": "keyword.control.module.jig" },
            "2": { "name": "entity.name.namespace.jig" }
          }
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "\\b(from)\\s+([a-zA-Z_][a-zA-Z0-9_.]*)\\s+(import)\\s+([a-zA-Z_][a-zA-Z0-9_,\\s]*)",
          "captures": {
            "1": { "name": "keyword.control.import.jig" },
            "2": { "name": "entity.name.namespace.jig" },
            "3": { "name": "keyword.control.import.jig" },
            "4": { "name": "entity.name.type.jig" }
          }
        }
      ]
    },
    "type-definitions": {
      "patterns": [
        {
          "match": "\\b(type)\\s+([A-Z][a-zA-Z0-9]*)\\s*=\\s*([A-Z][a-zA-Z0-9]*)\\(([a-z]+)\\)",
          "captures": {
            "1": { "name": "keyword.declaration.type.jig" },
            "2": { "name": "entity.name.type.jig" },
            "3": { "name": "entity.name.type.jig" },
            "4": { "name": "support.type.primitive.jig" }
          }
        },
        {
          "match": "\\b(record)\\s+([A-Z][a-zA-Z0-9]*)",
          "captures": {
            "1": { "name": "keyword.declaration.record.jig" },
            "2": { "name": "entity.name.type.jig" }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Z][a-zA-Z0-9]*)",
          "captures": {
            "1": { "name": "keyword.declaration.enum.jig" },
            "2": { "name": "entity.name.type.jig" }
          }
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "match": "\\b(def)\\s+([a-z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.declaration.function.jig" },
            "2": { "name": "entity.name.function.jig" }
          }
        },
        {
          "match": "\\b(effects|requires|ensures|examples):",
          "name": "keyword.other.special.jig"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.jig",
          "match": "\\b(if|elif|else|for|in|return|match|case|break|continue)\\b"
        },
        {
          "name": "keyword.other.jig",
          "match": "\\b(none|net|db|log|time|random|unsafe)\\b"
        },
        {
          "name": "constant.language.jig",
          "match": "\\b(True|False|Nothing)\\b"
        }
      ]
    },
    "builtin-types": {
      "patterns": [
        {
          "name": "support.type.primitive.jig",
          "match": "\\b(int|str|float|bool|bytes|list|dict|set|tuple)\\b"
        },
        {
          "name": "support.type.stdlib.jig",
          "match": "\\b(Result|Option|Ok|Err|Some|Ctx)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.jig",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jig",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "constant.numeric.jig",
          "match": "\\b[0-9]+\\.?[0-9]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.jig",
          "match": "\\+|-|\\*|/|//|%|==|!=|<|>|<=|>=|and|or|not"
        },
        {
          "name": "keyword.operator.arrow.jig",
          "match": "->"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.jig" }
          }
        }
      ]
    }
  }
}
