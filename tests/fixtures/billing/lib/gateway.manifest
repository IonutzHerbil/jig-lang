lib gateway

exception GatewayError
exception CardDeclined(GatewayError)

declare charge(customer_id: str, amount_cents: int, currency: str) -> str
    effects: net
    doc: "Charge a customer's saved card; returns the charge id"

declare refund(charge_id: str, amount_cents: int) -> str
    effects: net
    doc: "Refund part or all of a charge; returns the refund id"
