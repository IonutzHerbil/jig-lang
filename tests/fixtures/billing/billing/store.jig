module billing.store

"""In-memory persistence. Tests call reset() for a clean store."""

from billing.errors import NotFound
from billing.models import Customer, Invoice, Subscription

CUSTOMERS: dict[str, Customer] = {}
SUBSCRIPTIONS: dict[str, Subscription] = {}
INVOICES: dict[str, Invoice] = {}
COUNTERS: dict[str, int] = {}


def reset() -> None:
    for table in (CUSTOMERS, SUBSCRIPTIONS, INVOICES, COUNTERS):
        table.clear()


def next_id(prefix: str) -> str:
    COUNTERS[prefix] = COUNTERS.get(prefix, 0) + 1
    return f"{prefix}_{COUNTERS[prefix]}"


def save_customer(customer: Customer) -> Customer:
    CUSTOMERS[customer.id] = customer
    return customer


def get_customer(customer_id: str) -> Customer:
    if customer_id not in CUSTOMERS:
        raise NotFound(f"customer {customer_id}")
    return CUSTOMERS[customer_id]


def save_subscription(sub: Subscription) -> Subscription:
    SUBSCRIPTIONS[sub.id] = sub
    return sub


def get_subscription(sub_id: str) -> Subscription:
    if sub_id not in SUBSCRIPTIONS:
        raise NotFound(f"subscription {sub_id}")
    return SUBSCRIPTIONS[sub_id]


def subscriptions_of(customer_id: str) -> list[Subscription]:
    return [s for s in SUBSCRIPTIONS.values() if s.customer_id == customer_id]


def save_invoice(invoice: Invoice) -> Invoice:
    INVOICES[invoice.id] = invoice
    return invoice


def get_invoice(invoice_id: str) -> Invoice:
    if invoice_id not in INVOICES:
        raise NotFound(f"invoice {invoice_id}")
    return INVOICES[invoice_id]
