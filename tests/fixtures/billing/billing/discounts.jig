module billing.discounts

"""Coupons."""

from dataclasses import dataclass

from billing.errors import BillingError
from billing.money import percent_of


@dataclass(frozen=True)
class Coupon:
    code: str
    percent: float
    fixed_cents: int
    expires_day: int


COUPONS: dict[str, Coupon] = {
    "WELCOME10": Coupon("WELCOME10", 10.0, 0, 365),
    "FLAT500": Coupon("FLAT500", 0.0, 500, 10_000),
    "OLD": Coupon("OLD", 50.0, 0, 30),
}


class CouponError(BillingError):
    """An unknown or expired coupon."""


def discount_for(amount_cents: int, code: str, today: int) -> int:
    """How much a coupon takes off an amount on a given day; never more than the amount."""
    coupon = COUPONS.get(code)
    if coupon is None:
        raise CouponError(f"unknown coupon {code}")
    if today > coupon.expires_day:
        raise CouponError(f"coupon {code} expired")
    off = percent_of(amount_cents, coupon.percent) + coupon.fixed_cents
    return min(off, amount_cents)
