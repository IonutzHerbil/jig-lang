module billing.subscriptions

"""Starting, changing and ending subscriptions."""

from dataclasses import replace

from billing import store
from billing.catalog import TIER_RANK, get_plan
from billing.errors import InvalidChange
from billing.models import SubStatus, Subscription, Tier

TRIAL_DAYS = {Tier.PRO: 14, Tier.TEAM: 14}


def subscribe(customer_id: str, plan_code: str, seats: int, today: int) -> Subscription:
    """Start a subscription; PRO and TEAM plans begin with a trial."""
    store.get_customer(customer_id)
    plan = get_plan(plan_code)
    if seats < 1:
        raise InvalidChange("a subscription needs at least one seat")
    trial = TRIAL_DAYS.get(plan.tier, 0)
    sub = Subscription(
        id=store.next_id("sub"),
        customer_id=customer_id,
        plan_code=plan.code,
        seats=seats,
        status=SubStatus.TRIALING if trial else SubStatus.ACTIVE,
        started_day=today,
        trial_ends_day=today + trial,
    )
    return store.save_subscription(sub)


def _live(sub_id: str) -> Subscription:
    sub = store.get_subscription(sub_id)
    if sub.status == SubStatus.CANCELED:
        raise InvalidChange(f"subscription {sub_id} is canceled")
    return sub


def change_seats(sub_id: str, seats: int) -> Subscription:
    sub = _live(sub_id)
    if seats < 1:
        raise InvalidChange("a subscription needs at least one seat")
    return store.save_subscription(replace(sub, seats=seats))


def change_plan(sub_id: str, plan_code: str) -> Subscription:
    """Move to another plan. A downgrade must still fit the subscription's seats."""
    sub = _live(sub_id)
    old, new = get_plan(sub.plan_code), get_plan(plan_code)
    if TIER_RANK[new.tier] < TIER_RANK[old.tier] and new.seat_price_cents == 0 and sub.seats > new.included_seats:
        raise InvalidChange(f"{plan_code} allows {new.included_seats} seats, the subscription has {sub.seats}")
    return store.save_subscription(replace(sub, plan_code=new.code))


def cancel(sub_id: str, today: int) -> Subscription:
    sub = _live(sub_id)
    return store.save_subscription(replace(sub, status=SubStatus.CANCELED, canceled_day=today))


def end_trials(today: int) -> list[Subscription]:
    """Activate every subscription whose trial has ended by today."""
    ended = [s for s in store.SUBSCRIPTIONS.values() if s.status == SubStatus.TRIALING and s.trial_ends_day <= today]
    return [store.save_subscription(replace(s, status=SubStatus.ACTIVE)) for s in ended]
