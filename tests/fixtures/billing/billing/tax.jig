module billing.tax

"""Sales tax, from the external tax service."""

from billing.models import Customer
from billing.money import percent_of
from lib.taxsvc import TaxServiceDown, rate_for

FALLBACK_RATE = 20.0


def tax_rate(customer: Customer) -> float:
    """The customer's tax percent; exempt customers pay none. Falls back if the service is down."""
    if customer.tax_exempt:
        return 0.0
    try:
        return rate_for(customer.country)
    except TaxServiceDown:
        return FALLBACK_RATE


def tax_on(customer: Customer, amount_cents: int) -> int:
    return percent_of(amount_cents, tax_rate(customer))
