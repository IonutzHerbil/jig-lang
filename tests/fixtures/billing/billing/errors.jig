module billing.errors

"""Errors raised by the billing service."""


class BillingError(Exception):
    """Base class for every billing failure callers are expected to handle."""


class NotFound(BillingError):
    """A customer, plan, subscription or invoice does not exist."""


class InvalidChange(BillingError):
    """A subscription change that the rules do not allow."""


class PaymentFailed(BillingError):
    """The payment gateway refused or could not take a payment."""
